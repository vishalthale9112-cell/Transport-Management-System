DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Required only when the Supabase access token uses HS256:
SUPABASE_JWT_SECRET=

# Protects the existing THALE TRANSPORT data during first signup:
INITIAL_OWNER_EMAIL=your-email@example.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
